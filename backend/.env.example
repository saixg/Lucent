# ─── Lucent Environment Configuration ──────────────────────────────
# Application Environment (development | production)
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lucent

# Primary LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Transcription / Fallback LLM (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1

# Web Search Evidence (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Media Forensics (Sightengine)
SIGHTENGINE_API_USER=your_sightengine_api_user
SIGHTENGINE_API_SECRET=your_sightengine_api_secret
