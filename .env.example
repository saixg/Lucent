# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                     # development | production
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # server-side only, never expose to browser
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# ─── AI Models ────────────────────────────────────────────────────────────────
# Google Gemini  (primary multimodal reasoning + claim extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash          # or gemini-1.5-pro for higher quality

# OpenAI  (Whisper STT + optional GPT-4o fallback)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1                 # STT for audio/video transcription

# Anthropic  (optional Claude fallback for long reasoning chains)
ANTHROPIC_API_KEY=

# ─── Search & Web ─────────────────────────────────────────────────────────────
# Serper  (Google Search API — evidence retrieval)
SERPER_API_KEY=your_serper_api_key_here

# Tavily  (AI-optimized web search — recommended alternative)
TAVILY_API_KEY=your_tavily_api_key_here
# ─── Media Forensics ──────────────────────────────────────────────────────────
# Hive Moderation  (AI-generated image/video detection)
HIVE_API_KEY=your_hive_api_key_here

# Sightengine  (manipulation + deepfake detection)
SIGHTENGINE_API_USER=your_sightengine_api_user
SIGHTENGINE_API_SECRET=your_sightengine_api_secret

# ─── Platform Bots ────────────────────────────────────────────────────────────
# YouTube Data API v3  (comment monitoring + replies)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...               # OAuth token for the bot account

# ─── Background Jobs ──────────────────────────────────────────────────────────
REDIS_URL=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Supabase Storage bucket names
STORAGE_BUCKET_MEDIA=verilens-media
STORAGE_BUCKET_ARTIFACTS=verilens-artifacts

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...   # optional
